# CI/CD Pipeline for Copilot SDK architecture.
#
# What changed vs the current main.yml:
# ──────────────────────────────────────
# REMOVED:
#   - DeployPythonApp job (Azure Web App zip deploy)
#   - DeployFunctionsApp job (Azure Functions zip deploy)
#
# REPLACED WITH:
#   - BuildAndDeployApi job (Docker build → ACR push → Container App update)
#
# KEPT:
#   - Terraform job (infrastructure deployment, just uses updated Bicep/TF)
#   - Pool, variables, triggers

trigger: none
#  batch: true
#  branches:
#    include:
#      - "*"

parameters:
  - name: salt
    default: ""
  - name: useWorkspace
    default: false
    type: boolean

variables:
  - template: variables.yml
  - name: saltVar
    ${{ if eq(parameters.useWorkspace, true) }}:
      value: ${{ parameters.salt }}
    ${{ else }}:
      value: ""

pool:
  name: 'jasojohnson-mcaps'

jobs:
  - job: Terraform
    displayName: "Infrastructure Deployment"
    steps:
      - template: terraform.yml
        parameters:
          terraformVersion: $(terraformVersion)
          terraformPath: $(terraformPath)
          servicePrinciple: $(servicePrinciple)
          containerName: $(terraformContainerName)
          storageAccountName: $(terraformStorageAccountName)
          workspace: ${{ variables.saltVar }}
          useWorkspace: ${{ parameters.useWorkspace }}
          resourceGroupName: $(terraformResourceGroupName)
          env:
            TF_VAR_salt: ${{ variables.saltVar }}

  - job: BuildAndDeployApi
    displayName: "Build & Deploy API Container"
    dependsOn: Terraform
    variables:
      acr_login_server: $[ dependencies.Terraform.outputs['Terraform.container_registry_login_server'] ]
      acr_name: $[ dependencies.Terraform.outputs['Terraform.container_registry_name'] ]
      api_name: $[ dependencies.Terraform.outputs['Terraform.service_api_name'] ]
      resource_group_name: $[ dependencies.Terraform.outputs['Terraform.resource_group'] ]
    steps:
      # Login to ACR
      - task: AzureCLI@2
        displayName: "Login to ACR"
        inputs:
          azureSubscription: $(servicePrinciple)
          scriptType: bash
          scriptLocation: inlineScript
          inlineScript: |
            az acr login --name $(acr_name)

      # Build and push Docker image
      - task: Bash@3
        displayName: "Build Docker Image"
        inputs:
          targetType: 'inline'
          script: |
            IMAGE_TAG=$(Build.BuildId)
            IMAGE_NAME=$(acr_login_server)/$(api_name)

            echo "Building image: ${IMAGE_NAME}:${IMAGE_TAG}"
            docker build \
              -t ${IMAGE_NAME}:${IMAGE_TAG} \
              -t ${IMAGE_NAME}:latest \
              -f api/prototype_copilot_sdk/Dockerfile \
              api/prototype_copilot_sdk/

            echo "Pushing image: ${IMAGE_NAME}:${IMAGE_TAG}"
            docker push ${IMAGE_NAME}:${IMAGE_TAG}
            docker push ${IMAGE_NAME}:latest

            echo "##vso[task.setvariable variable=IMAGE_NAME]${IMAGE_NAME}"
            echo "##vso[task.setvariable variable=IMAGE_TAG]${IMAGE_TAG}"
          workingDirectory: '$(Build.SourcesDirectory)'

      # Update Container App with new image
      - task: AzureCLI@2
        displayName: "Deploy to Container App"
        inputs:
          azureSubscription: $(servicePrinciple)
          scriptType: bash
          scriptLocation: inlineScript
          inlineScript: |
            echo "Updating Container App $(api_name) with image $(IMAGE_NAME):$(IMAGE_TAG)"
            az containerapp update \
              --name $(api_name) \
              --resource-group $(resource_group_name) \
              --image $(IMAGE_NAME):$(IMAGE_TAG)
